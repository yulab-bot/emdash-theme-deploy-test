{
	"name": "emdash-theme-site",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"emdash": {
		"label": "Blog",
		"seed": "seed/seed.json"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "node scripts/deploy.mjs",
		"typecheck": "astro check"
	},
	"cloudflare": {
		"bindings": {
			"EMDASH_ENCRYPTION_KEY": {
				"description": "サイトが設定を暗号化するための鍵。`emdash_enc_v1_` で始まる 57 文字の決まった形です（渡された値をそのまま貼ってください。ターミナルが使える人は `npx emdash secrets generate` で作れます）。一度決めたら変えないでください。"
			},
			"EMDASH_PREVIEW_SECRET": {
				"description": "AI（ChatGPT など）が下書きのプレビュー URL を作るときに使う鍵。長いランダムな文字列なら何でもよいです。"
			},
			"YULAB_KEY": {
				"description": "テーマを受け取るための鍵。いまは試し用の値のままで動きます（そのまま進めてください）。"
			}
		}
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.1",
		"@astrojs/react": "^7.0.0",
		"@emdash-cms/cloudflare": "^1.3.0",
		"@yulab/emdash-theme": "https://emdash-theme-parent-temp.emdash-lab.workers.dev/parent/yulab-emdash-theme-0.5.0.tgz",
		"astro": "^7.3.2",
		"emdash": "^1.3.0",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@cloudflare/workers-types": "^5.20260820.1",
		"wrangler": "^4.125.0"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
